  {"name": "scalars and nested objects", "json": "{\"client\":{\"name\":\"Jane Doe\",\"dob\":\"1986-07-14T00:00:00Z\",\"age\":40},\"active\":true,\"notes\":null}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"name": ":root > [key='client'] > [key='name']", "dob": ":root > [key='client'] > [key='dob'] | date", "age": ":root > [key='client'] > [key='age'] | int", "active": ":root > [key='active'] | bool", "activeText": ":root > [key='active']", "notes": ":root > [key='notes']", "missing": ":root > [key='nope']"}, "expected": {"name": "Jane Doe", "dob": "1986-07-14", "age": 40, "active": true, "activeText": "true", "notes": null, "missing": null}},
  {"name": "anchored paths never pick up a key nested elsewhere", "json": "{\"dob\":\"1990-01-01\",\"partner\":{\"dob\":\"1985-02-02\"}}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"own": ":root > [key='dob']", "partner": ":root > [key='partner'] > [key='dob']", "first": "[key='dob']"}, "expected": {"own": "1990-01-01", "partner": "1985-02-02", "first": "1990-01-01"}},
  {"name": "numbers keep their text: big integers, trailing zeros, exponents written out", "json": "{\"id\":12345678901234567890,\"rent\":412.50,\"e\":1.5e3,\"small\":2.5E-3,\"neg\":-0,\"zero\":0e5}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"id": ":root > [key='id']", "rent": ":root > [key='rent']", "rentNumber": ":root > [key='rent'] | number", "e": ":root > [key='e']", "eNumber": ":root > [key='e'] | number", "small": ":root > [key='small']", "neg": ":root > [key='neg']", "zero": ":root > [key='zero']"}, "expected": {"id": "12345678901234567890", "rent": "412.50", "rentNumber": 412.5, "e": "1500", "eNumber": 1500, "small": "0.0025", "neg": "-0", "zero": "0"}},
  {"name": "strings: line breaks, spaces collapsed, an empty string reads nothing", "json": "{\"address\":\"Flat 3\\n12 Mill Lane\\nNorthtown\",\"spaced\":\"  Jane   Doe  \",\"empty\":\"\",\"markup\":\"<img src=x onerror=alert(1)>\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"text": ":root > [key='address']", "lines": ":root > [key='address'] | lines", "one": ":root > [key='address'] | oneline", "spaced": ":root > [key='spaced']", "empty": ":root > [key='empty']", "markup": ":root > [key='markup']"}, "expected": {"text": "Flat 3\n12 Mill Lane\nNorthtown", "lines": ["Flat 3", "12 Mill Lane", "Northtown"], "one": "Flat 3, 12 Mill Lane, Northtown", "spaced": "Jane Doe", "empty": null, "markup": "<img src=x onerror=alert(1)>"}},
  {"name": "escapes and lone surrogates", "json": "{\"q\":\"say \\\"hi\\\" \\\\ \\/ \\u00e9\",\"pair\":\"\\ud83d\\ude00\",\"lone\":\"a\\ud800b\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"q": ":root > [key='q']", "pair": ":root > [key='pair']", "lone": ":root > [key='lone']"}, "expected": {"q": "say \"hi\" \\ / é", "pair": "😀", "lone": "a�b"}},
  {"name": "a root array: each item is a row, and an empty row is dropped", "json": "[{\"date\":\"2026-10-01\",\"amount\":412.5},{\"date\":\"2026-11-01\",\"amount\":\"400.00\"},{\"date\":null,\"amount\":null}]", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"payments": [":root > *", {"@type": "Payment", "date": ":scope > [key='date'] | date", "amount": ":scope > [key='amount'] | number"}]}, "expected": {"payments": [{"@type": "Payment", "date": "2026-10-01", "amount": 412.5}, {"@type": "Payment", "date": "2026-11-01", "amount": 400}]}},
  {"name": "rows in an object, with a nested list in each row", "json": "{\"tenancies\":[{\"start\":\"2020-01-06\",\"people\":[{\"name\":\"Jane\"},{\"name\":\"Sam\"}]},{\"start\":\"2023-04-03\",\"people\":[{\"name\":\"Jane\"}]}]}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"tenancies": [":root > [key='tenancies'] > *", {"start": ":scope > [key='start'] | date", "people": [":scope > [key='people'] > *", ":scope > [key='name']"]}]}, "expected": {"tenancies": [{"start": "2020-01-06", "people": ["Jane", "Sam"]}, {"start": "2023-04-03", "people": ["Jane"]}]}},
  {"name": "arrays of scalars, and nested arrays", "json": "{\"tags\":[\"urgent\",\"dhp\"],\"grid\":[[1,2],[3,4]]}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"tags": [":root > [key='tags'] > *"], "rows": [":root > [key='grid'] > *", {"a": ":scope > [index='0']", "b": ":scope > [index='1'] | int"}], "corner": ":root > [key='grid'] > [index='1'] > [index='1']"}, "expected": {"tags": ["urgent", "dhp"], "rows": [{"a": "1", "b": 2}, {"a": "3", "b": 4}], "corner": "4"}},
  {"name": "$scope narrows to an object", "json": "{\"tenancy\":{\"start\":\"2021-05-04\",\"type\":\"Secure\"},\"start\":\"1999-01-01\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"tenancy": {"$scope": ":root > [key='tenancy']", "start": ":scope > [key='start'] | date", "type": ":scope > [key='type']"}}, "expected": {"tenancy": {"start": "2021-05-04", "type": "Secure"}}},
  {"name": "an object keyed by data: rows, with @key", "json": "{\"payments\":{\"P-1042\":{\"amount\":10},\"P-1043\":{\"amount\":20}}}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"payments": [":root > [key='payments'] > *", {"id": "@key", "amount": ":scope > [key='amount'] | number"}]}, "expected": {"payments": [{"id": "P-1042", "amount": 10}, {"id": "P-1043", "amount": 20}]}},
  {"name": "label() on key/value pairs finds the value, never a key", "json": "{\"facts\":[{\"name\":\"Status\",\"value\":\"Open\"},{\"name\":\"Officer\",\"value\":\"R. Patel\"}],\"Status\":\"not this\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"status": ":root > [key='facts'] label(Status)", "officer": ":root > [key='facts'] label(Officer)"}, "expected": {"status": "Open", "officer": "R. Patel"}},
  {"name": "odd keys are attribute values", "json": "{\"first name\":\"Jane\",\"\":\"empty key\",\"a.b\":\"dotted\",\"été\":\"accent\",\"it's\":\"quote\",\"back\\\\slash\":\"bs\",\"0\":\"zero\",\"Name\":\"upper\",\"name\":\"lower\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"space": ":root > [key='first name']", "empty": ":root > [key='']", "dotted": ":root > [key='a.b']", "accent": ":root > [key='été']", "quote": ":root > [key='it\\'s']", "bs": ":root > [key='back\\\\slash']", "zero": ":root > [key='0']", "upper": ":root > [key='Name']", "lower": ":root > [key='name']"}, "expected": {"space": "Jane", "empty": "empty key", "dotted": "dotted", "accent": "accent", "quote": "quote", "bs": "bs", "zero": "zero", "upper": "upper", "lower": "lower"}},
  {"name": "keys that would mean something to the engine are only attributes", "json": "{\"input\":\"a\",\"script\":\"b\",\"br\":\"c\",\"select\":\"d\",\"style\":\"e\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"input": ":root > [key='input']", "script": ":root > [key='script']", "br": ":root > [key='br']", "select": ":root > [key='select']", "style": ":root > [key='style']", "all": ":root"}, "expected": {"input": "a", "script": "b", "br": "c", "select": "d", "style": "e", "all": "abcde"}},
  {"name": "prototype keys are plain text", "json": "{\"__proto__\":{\"polluted\":\"yes\"},\"constructor\":\"c\",\"prototype\":{\"x\":\"p\"}}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"proto": ":root > [key='__proto__'] > [key='polluted']", "ctor": ":root > [key='constructor']", "prototype": ":root > [key='prototype'] > [key='x']"}, "expected": {"proto": "yes", "ctor": "c", "prototype": "p"}},
  {"name": "a repeated key: both kept, and extraction takes the first", "json": "{\"status\":\"Open\",\"status\":\"Closed\"}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"status": ":root > [key='status']", "all": [":root > [key='status']"]}, "expected": {"status": "Open", "all": ["Open", "Closed"]}},
