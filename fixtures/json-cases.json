  {"name": "when checks a key exists", "json": "{\"clientId\":\"NC-1042\",\"person\":{\"dateOfBirth\":\"1986-07-14\"}}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"dob": ":root > [key='person'] > [key='dateOfBirth'] | date"}, "expected": {"dob": "1986-07-14"}, "when": ":root > [key='clientId']", "applies": true},
  {"name": "when on a response without that key", "json": "{\"tenancy\":{}}", "url": "https://cm.example.gov.uk/api/clients/1042", "fields": {"dob": ":root > [key='person'] > [key='dateOfBirth'] | date"}, "expected": {"dob": null}, "when": ":root > [key='clientId']", "applies": false}
