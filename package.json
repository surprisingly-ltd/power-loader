{
  "name": "power-loader",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "type": "module",
  "scripts": {
    "test": "node tools/build-demo-systems.mjs --quiet && node --test 'tests/js/*.test.js'",
    "lint:ext": "web-ext lint --self-hosted --source-dir extension",
    "start:firefox": "web-ext run --source-dir extension --start-url http://localhost:8787/demo/",
    "build:ext": "node tools/build-ext.mjs",
    "demo": "node tools/serve-demo.mjs",
    "site": "node tools/serve-site.mjs",
    "test:live": "node tests/tools/live-smoke.mjs",
    "test:prototype": "node prototype/tests/run-all.mjs",
    "fixtures:candidates": "node tests/tools/regen-expected.mjs",
    "vendor": "node tools/vendor.mjs",
    "build:site": "node tools/vendor.mjs && node tools/build-site.mjs",
    "bundle:source": "node tools/source-bundle.mjs",
    "test:firefox": "node tests/tools/firefox-suite.mjs",
    "test:firefox:smoke": "node tests/tools/firefox-smoke.mjs",
    "test:firefox:org": "node tests/tools/firefox-org-build.mjs",
    "check:vendor": "node tools/check-vendor.mjs",
    "check:lint": "node tools/check-lint.mjs",
    "check:site": "node tools/check-site.mjs",
    "demo:systems": "node tools/build-demo-systems.mjs",
    "check:policy": "node tools/policy.mjs check",
    "check:demo": "node tools/build-demo-systems.mjs --check && node tools/build-demo-library.mjs --check"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "1.65.1",
    "@tesseract.js-data/eng": "1.0.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "4.10.38",
    "ses": "^2.3.0",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1",
    "web-ext": "10.8.0",
    "zip-dir": "2.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/surprisingly-ltd/power-loader.git"
  },
  "homepage": "https://powerloader.surprisingly.ltd"
}
