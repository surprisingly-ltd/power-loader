{
  "schema": "powerloader-flow/1",
  "id": "discretionary-housing-payment",
  "name": "Discretionary housing payment",
  "guidance": "A demo flow made from the Power Loader demo library. It fills the Discretionary housing payment form from the fictional Northshire pages.",
  "hosts": [
    "localhost:8787"
  ],
  "fields": {
    "firstName": {
      "label": "First name",
      "identity": true,
      "accepts": [
        "first_name",
        "person_name"
      ],
      "section": "Client"
    },
    "lastName": {
      "label": "Last name",
      "identity": true,
      "accepts": [
        "last_name",
        "person_name"
      ],
      "section": "Client"
    },
    "dob": {
      "label": "Date of birth",
      "type": "date",
      "identity": "strong",
      "accepts": [
        "date_of_birth",
        "date"
      ],
      "section": "Client"
    },
    "nino": {
      "label": "National Insurance number",
      "type": "nino",
      "identity": "strong",
      "accepts": [
        "nino"
      ],
      "section": "Client"
    },
    "address": {
      "label": "Address",
      "long": true,
      "accepts": [
        "address",
        "postcode"
      ],
      "section": "Contact"
    },
    "postcode": {
      "label": "Postcode",
      "type": "postcode",
      "accepts": [
        "postcode"
      ],
      "section": "Contact"
    },
    "landlord": {
      "label": "Landlord",
      "section": "Housing"
    },
    "tenancyStart": {
      "label": "Tenancy start",
      "type": "date",
      "accepts": [
        "date"
      ],
      "section": "Housing"
    },
    "monthlyRent": {
      "label": "Monthly rent",
      "type": "money",
      "section": "Housing"
    },
    "arrears": {
      "label": "Rent arrears",
      "type": "money",
      "section": "Housing"
    },
    "currentEmployer": {
      "label": "Current employer",
      "section": "Income"
    },
    "weeklyIncome": {
      "label": "Weekly income",
      "type": "money",
      "section": "Income"
    },
    "ucClaim": {
      "label": "Universal Credit claim",
      "section": "Income"
    },
    "reason": {
      "label": "Reason for application",
      "long": true,
      "manual": true,
      "section": "Your assessment"
    }
  },
  "journey": [
    "p-00000001",
    "p-00000002",
    "p-00000003",
    "p-00000004"
  ],
  "timelines": [],
  "pages": [
    {
      "id": "p-00000004",
      "role": "output",
      "name": "Discretionary housing payment",
      "url": "http://localhost:8787/demo/dhp.html",
      "required": [
        "firstName",
        "lastName",
        "dob",
        "nino",
        "address",
        "postcode",
        "landlord",
        "monthlyRent",
        "arrears",
        "weeklyIncome",
        "reason"
      ],
      "step": {
        "text": "Open Discretionary housing payment, fill it from the case, check every box, then submit it yourself.",
        "links": []
      },
      "formId": "dhp",
      "form": {
        "version": "v2",
        "short": "DHP",
        "category": "Housing",
        "rules": [
          {
            "field": "tenancyStart",
            "before": "today",
            "message": "The tenancy start must be before today"
          }
        ],
        "confirmation": {
          "match": [
            "http://localhost:8787/demo/dhp-submitted.html*"
          ],
          "refPattern": "DHP-\\d{5}"
        },
        "sideEffects": [
          "Leaving the NI number box looks the claimant up and shows their name next to it."
        ]
      },
      "kind": "fill",
      "profile": {
        "schema": "powerloader-profile/1",
        "id": "fill/dhp",
        "kind": "fill",
        "name": "Discretionary housing payment",
        "version": "v2",
        "form": {
          "id": "dhp",
          "version": "v2"
        },
        "match": [
          "http://localhost:8787/demo/dhp.html*"
        ],
        "urlPattern": "http://localhost:8787/demo/dhp.html",
        "when": "form#dhp",
        "fields": {
          "#d-first": "CaseData.firstName",
          "#d-last": "CaseData.lastName",
          "#d-dob": "CaseData.dob",
          "#d-nino": "CaseData.nino",
          "#d-address": "CaseData.address",
          "#d-postcode": "CaseData.postcode",
          "#d-landlord": "CaseData.landlord",
          "#d-start": "CaseData.tenancyStart",
          "#d-rent": "CaseData.monthlyRent",
          "#d-arrears": "CaseData.arrears",
          "#d-employer": "CaseData.currentEmployer",
          "#d-income": "CaseData.weeklyIncome",
          "#d-uc": "CaseData.ucClaim",
          "#d-reason": "CaseData.reason"
        }
      },
      "picks": [
        {
          "box": "#d-first",
          "key": "firstName"
        },
        {
          "box": "#d-last",
          "key": "lastName"
        },
        {
          "box": "#d-dob",
          "key": "dob"
        },
        {
          "box": "#d-nino",
          "key": "nino"
        },
        {
          "box": "#d-address",
          "key": "address"
        },
        {
          "box": "#d-postcode",
          "key": "postcode"
        },
        {
          "box": "#d-landlord",
          "key": "landlord"
        },
        {
          "box": "#d-start",
          "key": "tenancyStart"
        },
        {
          "box": "#d-rent",
          "key": "monthlyRent"
        },
        {
          "box": "#d-arrears",
          "key": "arrears"
        },
        {
          "box": "#d-employer",
          "key": "currentEmployer"
        },
        {
          "box": "#d-income",
          "key": "weeklyIncome"
        },
        {
          "box": "#d-uc",
          "key": "ucClaim"
        },
        {
          "box": "#d-reason",
          "key": "reason"
        }
      ]
    },
    {
      "id": "p-00000001",
      "role": "input",
      "name": "Employment and income",
      "url": "http://localhost:8787/demo/employment-{clientId}.html",
      "required": [],
      "step": {
        "text": "Open the client’s employment and income and clip it.",
        "links": []
      },
      "profileId": "biv/employment",
      "kind": "extract",
      "profile": {
        "schema": "powerloader-profile/1",
        "id": "biv/employment",
        "kind": "extract",
        "name": "Employment and income",
        "version": "v2",
        "match": [
          "http://localhost:8787/demo/employment-*.html*"
        ],
        "urlPattern": "http://localhost:8787/demo/employment-{clientId}.html",
        "fields": {
          "lastName": "#person label(Surname)",
          "nino": "#person label(NI number)",
          "dob": "#person label(Date of birth) | date",
          "currentEmployer": "#person label(Current employer)",
          "weeklyIncome": "#person label(Weekly income) | number",
          "ucClaim": "#person label(Universal Credit)",
          "periods": [
            "#history tbody tr",
            {
              "@type": "period",
              "cat": "td:nth-child(1)",
              "label": "td:nth-child(2)",
              "start": "td:nth-child(3) | date",
              "end": "td:nth-child(4) | date"
            }
          ]
        }
      },
      "picks": [
        {
          "key": "lastName",
          "selector": "#person label(Surname)",
          "part": "all"
        },
        {
          "key": "nino",
          "selector": "#person label(NI number)",
          "part": "all"
        },
        {
          "key": "dob",
          "selector": "#person label(Date of birth) | date",
          "part": "all"
        },
        {
          "key": "currentEmployer",
          "selector": "#person label(Current employer)",
          "part": "all"
        },
        {
          "key": "weeklyIncome",
          "selector": "#person label(Weekly income) | number",
          "part": "all"
        },
        {
          "key": "ucClaim",
          "selector": "#person label(Universal Credit)",
          "part": "all"
        }
      ]
    },
    {
      "id": "p-00000002",
      "role": "input",
      "name": "Client record",
      "url": "http://localhost:8787/demo/client-{clientId}.html",
      "required": [],
      "step": {
        "text": "Open the client’s client record and clip it.",
        "links": []
      },
      "profileId": "cm/client-record",
      "kind": "extract",
      "profile": {
        "schema": "powerloader-profile/1",
        "id": "cm/client-record",
        "kind": "extract",
        "name": "Client record",
        "version": "v3",
        "match": [
          "http://localhost:8787/demo/client-*.html*"
        ],
        "urlPattern": "http://localhost:8787/demo/client-{clientId}.html",
        "when": "#client-header",
        "fields": {
          "firstName": "table.details label(First name)",
          "lastName": "table.details label(Last name)",
          "dob": "table.details label(Date of birth) | date",
          "nino": "table.details label(NI number)",
          "address": "#c-address | oneline",
          "postcode": "#c-address | regex:([A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2})"
        }
      },
      "picks": [
        {
          "key": "firstName",
          "selector": "table.details label(First name)",
          "part": "all"
        },
        {
          "key": "lastName",
          "selector": "table.details label(Last name)",
          "part": "all"
        },
        {
          "key": "dob",
          "selector": "table.details label(Date of birth) | date",
          "part": "all"
        },
        {
          "key": "nino",
          "selector": "table.details label(NI number)",
          "part": "all"
        },
        {
          "key": "address",
          "selector": "#c-address | oneline",
          "part": "all"
        },
        {
          "key": "postcode",
          "selector": "#c-address | regex:([A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2})",
          "part": "all"
        }
      ]
    },
    {
      "id": "p-00000003",
      "role": "input",
      "name": "Rent account",
      "url": "http://localhost:8787/demo/rent-account-{tenancyRef}.html",
      "required": [],
      "step": {
        "text": "Open the client’s rent account and clip it.",
        "links": []
      },
      "profileId": "harbour-homes/rent-account",
      "kind": "extract",
      "profile": {
        "schema": "powerloader-profile/1",
        "id": "harbour-homes/rent-account",
        "kind": "extract",
        "name": "Rent account",
        "version": "v1",
        "match": [
          "http://localhost:8787/demo/rent-account-*.html*"
        ],
        "urlPattern": "http://localhost:8787/demo/rent-account-{tenancyRef}.html",
        "fields": {
          "firstName": "dd.tenant | regex:^(\\S+)",
          "lastName": "dd.tenant | regex:(\\S+)$",
          "address": "#tenancy label(Property)",
          "postcode": "#tenancy label(Property) | regex:([A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2})$",
          "landlord": "#tenancy label(Landlord)",
          "tenancyStart": "#tenancy label(Tenancy start) | date",
          "monthlyRent": "#tenancy label(Monthly rent) | number",
          "arrears": "#tenancy label(Arrears) | number",
          "payments": [
            "#payments tbody tr",
            {
              "@type": "money",
              "date": "td:nth-child(1) | date",
              "label": "td:nth-child(2)",
              "amount": "td:nth-child(3) | number"
            }
          ]
        }
      },
      "picks": [
        {
          "key": "firstName",
          "selector": "dd.tenant | regex:^(\\S+)",
          "part": "all"
        },
        {
          "key": "lastName",
          "selector": "dd.tenant | regex:(\\S+)$",
          "part": "all"
        },
        {
          "key": "address",
          "selector": "#tenancy label(Property)",
          "part": "all"
        },
        {
          "key": "postcode",
          "selector": "#tenancy label(Property) | regex:([A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2})$",
          "part": "all"
        },
        {
          "key": "landlord",
          "selector": "#tenancy label(Landlord)",
          "part": "all"
        },
        {
          "key": "tenancyStart",
          "selector": "#tenancy label(Tenancy start) | date",
          "part": "all"
        },
        {
          "key": "monthlyRent",
          "selector": "#tenancy label(Monthly rent) | number",
          "part": "all"
        },
        {
          "key": "arrears",
          "selector": "#tenancy label(Arrears) | number",
          "part": "all"
        }
      ]
    }
