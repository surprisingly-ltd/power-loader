{
  "schema": "powerloader-profile/1",
  "id": "biv/income",
  "kind": "extract",
  "name": "Employment and income record",
  "version": "v1",
  "match": [
    "http://localhost:8787/demo/biv/income-*.html*"
  ],
  "urlPattern": "http://localhost:8787/demo/biv/income-{clientId}.html",
  "when": "#person",
  "fields": {
    "firstName": "#person label(First names)",
    "lastName": "#person label(Surname)",
    "nino": "#person label(NI number)",
    "dob": "#person label(Date of birth) | date",
    "clientId": "#person label(Council reference)",
    "employmentStatus": "#person label(Employment status)",
    "currentEmployer": "#person label(Current employer)",
    "weeklyIncome": "#person label(Weekly income) | number",
    "ucClaim": "#person label(Universal Credit)",
    "periods": [
      "#history tbody tr",
      {
        "@type": "period",
        "cat": "td:nth-child(1)",
        "label": "td:nth-child(2)",
        "start": "td:nth-child(3) | date",
        "end": "td:nth-child(4) | date"
      }
    ]
  }
}
